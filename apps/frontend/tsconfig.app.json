{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "ignoreDeprecations": "6.0",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "jsx": "react-jsx",
    "strict": true,
    "target": "ES2022",
    "types": [
      "vite/client",
      "node",
      "monaco-editor"
    ],
    "useDefineForClassFields": true
  },
  "include": [
    "src"
  ]
}